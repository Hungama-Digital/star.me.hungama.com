<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. StarME is dark-only; Compose supplies the real
         Material 3 color scheme. This keeps the pre-Compose window dark so there
         is no white flash on cold start. -->
    <style name="Theme.StarME" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
