# EAS Build ignore file
# Only ignore files that are not needed for the build

# Dependencies (will be installed during build)
node_modules/

# Build outputs
builds/
*.apk
*.aab
*.ipa

# IDE files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temporary files
tmp/
temp/

# Do NOT ignore android/ or ios/ directories - they are needed for native builds
