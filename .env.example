# Safe local-development defaults only. Never place credentials or personal data here.
STARME_ENVIRONMENT=local
STARME_LOG_LEVEL=INFO
STARME_API_HOST=127.0.0.1
STARME_API_PORT=8000
STARME_DATABASE_URL=postgresql+psycopg://starme:starme_local_only@127.0.0.1:5432/starme
STARME_REDIS_URL=redis://127.0.0.1:6379/0
STARME_QUEUE_BACKEND=inline
STARME_STORAGE_BACKEND=disabled
STARME_RENDER_PROVIDER=disabled
STARME_SIGNED_URL_TTL_SECONDS=900
STARME_DOWNLOAD_URL_TTL_SECONDS=1800
STARME_ALLOW_SENSITIVE_PROCESSING=false
STARME_OPERATOR_API_KEY=replace-with-a-long-random-operator-key
STARME_TOKEN_HASH_PEPPER=replace-with-a-long-random-token-pepper
STARME_DELIVERY_SIGNING_KEY=replace-with-a-long-random-delivery-key
STARME_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Leave unset until Nitin/Trilegal provides the exact approved version.
STARME_APPROVED_CONSENT_VERSION=
