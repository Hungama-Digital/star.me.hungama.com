# Safe local-development defaults only. Never place credentials or personal data here.
STARME_ENVIRONMENT=local
STARME_LOG_LEVEL=INFO
STARME_API_HOST=127.0.0.1
STARME_API_PORT=8000
STARME_DATABASE_URL=postgresql+psycopg://starme:starme_local_only@127.0.0.1:5432/starme
STARME_REDIS_URL=redis://127.0.0.1:6379/0
# Compose host bindings and its internal PostgreSQL credential. Use an independent random value
# containing only URL-safe characters on staging because it is interpolated into DATABASE_URL.
STARME_POSTGRES_PASSWORD=starme_local_only
STARME_POSTGRES_BIND=127.0.0.1
STARME_POSTGRES_PORT=5432
STARME_REDIS_BIND=127.0.0.1
STARME_REDIS_PORT=6379
STARME_API_BIND=127.0.0.1
STARME_QUEUE_BACKEND=inline
STARME_STORAGE_BACKEND=disabled
STARME_RENDER_PROVIDER=disabled
STARME_SIGNED_URL_TTL_SECONDS=900
STARME_DOWNLOAD_URL_TTL_SECONDS=1800
STARME_ALLOW_SENSITIVE_PROCESSING=false
STARME_OPERATOR_API_KEY=replace-with-a-long-random-operator-key
STARME_TOKEN_HASH_PEPPER=replace-with-a-long-random-token-pepper
STARME_DELIVERY_SIGNING_KEY=replace-with-a-long-random-delivery-key
STARME_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Leave unset until Nitin/Trilegal provides the exact approved version.
STARME_APPROVED_CONSENT_VERSION=

# BytePlus ModelArk / Seedance 2.0. Keep real values only in the ignored .env file.
# The API key authorizes /api/v3 video-generation requests.
STARME_BYTEPLUS_API_KEY=
STARME_BYTEPLUS_MODEL=dreamina-seedance-2-0-260128
STARME_BYTEPLUS_API_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
STARME_BYTEPLUS_PROJECT_NAME=default
STARME_BYTEPLUS_REGION=ap-southeast-1
STARME_BYTEPLUS_LIVENESS_CALLBACK_URL=https://starme.hungama.com/v1/byteplus/liveness/callback
# The AK/SK pair is separate from the API key and is required for the private
# real-human asset library (liveness verification, asset groups, and assets).
STARME_BYTEPLUS_ACCESS_KEY=
STARME_BYTEPLUS_SECRET_KEY=
STARME_BYTEPLUS_POLL_INTERVAL_SECONDS=5
STARME_BYTEPLUS_TASK_TIMEOUT_SECONDS=900
STARME_RENDER_WORK_DIR=tmp/renders
